# Copy to api/.env (not committed) and fill in. Values here are overridden by environment
# variables and by config.local.php. All keys of api/config.php can be set here.

# E-mails via SMTP
MAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587               # 465 = implicit TLS (SMTPS), otherwise STARTTLS when offered
SMTP_AUTH=true
SMTP_SENDER=rezervace@example.com
SMTP_USER=                  # only when the login differs from SMTP_SENDER (e.g. apikey)
SMTP_PASSWORD="change-me"

# Contact of the organizers: website footer and every e-mail (Reply-To = CONTACT_EMAIL)
CONTACT_EMAIL=farnost@example.com
CONTACT_PHONE="+420 123 456 789"

# Base URL for links in e-mails
PUBLIC_URL=https://example.com/zidle/
